# Salin ke .env HANYA untuk lokal. Isi nilai asli di dashboard Vercel untuk online.
# Kosongkan DATABASE_URL hanya untuk SQLite lokal; Vercel wajib PostgreSQL/Supabase.
DATABASE_URL=
SESSION_SECRET=
INITIAL_ADMIN_USERNAME=admin_api
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator PT API

# Google Sheets sekarang OPSIONAL (backup/export), bukan sumber transaksi utama.
# off    = tidak mengirim salinan ke Sheets (disarankan setelah pindah ke Supabase)
# mirror = mengirim salinan perubahan ke Apps Script; isi APPS_SCRIPT_URL + SYNC_API_KEY
SHEETS_MODE=off
APPS_SCRIPT_URL=
SYNC_API_KEY=
GOOGLE_SHEET_URL=

# Impor penuh dari Sheets lewat /api/sync hanya untuk pemulihan darurat.
# Biarkan 0. Setup baru memakai init_db(); migrasi CSV lama memakai migrate_to_supabase.py.
ALLOW_SHEETS_IMPORT=0

# Opsional: koneksi langsung hanya untuk init/impor manual. Aplikasi membaca DATABASE_URL.
# SUPABASE_DIRECT_URL=

# Untuk migrasi CSV lama saja: isi di .env.migration, jangan di .env produksi.
# SUPABASE_DATABASE_URL=
